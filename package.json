{
    "name": "dwmc-web",
    "private": true,
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "next dev -p 5182",
        "dev:legacy": "vite",
        "build": "next build",
        "build:legacy": "tsc -b && vite build",
        "profile:build": "npm run build:legacy && node scripts/report-bundle-size.mjs",
        "preview:legacy": "vite preview",
        "start": "next start -p 5182",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test --config playwright.next.config.ts",
        "test:e2e:ui": "playwright test --config playwright.next.config.ts --ui",
        "test:e2e:legacy": "playwright test --config playwright.config.ts",
        "test:e2e:legacy:ui": "playwright test --config playwright.config.ts --ui",
        "test:e2e:live": "playwright test --config playwright.next.live.config.ts",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prepare": "husky",
        "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build:legacy && npm run build"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.9.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-progress": "^1.2.1",
        "@radix-ui/react-radio-group": "^1.5.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@supabase/ssr": "^0.12.7",
        "@supabase/supabase-js": "^2.118.0",
        "@tanstack/react-query": "^5.104.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.58.0",
        "next": "^16.4.2",
        "react": "^19.3.1",
        "react-day-picker": "^9.14.0",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.90.0",
        "react-router-dom": "^7.18.4",
        "recharts": "^3.10.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.64.1",
        "@storybook/addon-a11y": "^10.6.2",
        "@storybook/addon-docs": "^10.6.2",
        "@storybook/addon-themes": "^10.6.2",
        "@storybook/addon-vitest": "^10.6.2",
        "@storybook/nextjs-vite": "^10.6.2",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/browser-playwright": "5.0.5",
        "@vitest/coverage-v8": "^5.0.5",
        "chromatic": "^17.8.0",
        "dotenv": "^18.0.8",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.6.0",
        "msw": "^3.0.3",
        "msw-storybook-addon": "^3.0.3",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "shadcn": "^4.22.0",
        "storybook": "^10.6.2",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "vitest-axe": "^0.1.0"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix --max-warnings 0",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
