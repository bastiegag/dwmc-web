{
    "name": "dwmc-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "profile:build": "npm run build && node scripts/report-bundle-size.mjs",
        "preview": "vite preview",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prepare": "husky",
        "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.2.9",
        "@hookform/resolvers": "^5.2.2",
        "@radix-ui/react-checkbox": "^1.1.5",
        "@radix-ui/react-label": "^2.1.11",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.5",
        "@radix-ui/react-radio-group": "^1.2.3",
        "@radix-ui/react-select": "^2.3.4",
        "@radix-ui/react-slot": "^1.1.1",
        "@radix-ui/react-switch": "^1.1.4",
        "@radix-ui/react-tabs": "^1.1.13",
        "@supabase/supabase-js": "^2.46.2",
        "@tanstack/react-query": "^5.62.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.16.0",
        "react": "^19.2.7",
        "react-day-picker": "^9.8.0",
        "react-dom": "^19.2.7",
        "react-hook-form": "^7.54.0",
        "react-router-dom": "^7.15.1",
        "recharts": "^3.1.2",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.61.1",
        "@storybook/addon-a11y": "^10.4.0",
        "@storybook/addon-themes": "^10.4.0",
        "@storybook/react-vite": "^10.4.0",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.5.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/coverage-v8": "^4.1.10",
        "chromatic": "^17.2.0",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.0.4",
        "msw": "^2.7.0",
        "msw-storybook-addon": "^2.0.7",
        "prettier": "^3.4.2",
        "shadcn": "^4.7.0",
        "storybook": "^10.4.0",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0",
        "vite": "^8.1.3",
        "vitest": "^4.1.10",
        "vitest-axe": "^0.1.0"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix --max-warnings 0",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
