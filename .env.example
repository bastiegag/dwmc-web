# Active Next.js frontend origin. The legacy Vite rollback also uses this port.
NEXT_PUBLIC_APP_URL=http://localhost:5182

# Next.js SSR/browser Supabase clients.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Frontend origin used by Supabase Auth redirect URLs for the legacy Vite runtime.
VITE_APP_URL=http://localhost:5182

# Supabase browser client configuration. These values are public client values.
# https://supabase.com/dashboard/project/<project-ref>/settings/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Backend API origin. The local Vite proxy forwards this path to dwmc-api.
VITE_API_URL=/api/v1

# Server-side API origin used by the Next.js rewrite. This is the independent
# dwmc-api service and must not contain backend credentials.
DWMC_API_URL=http://localhost:3000/api/v1

# Never add DATABASE_URL, PostgreSQL credentials, or other backend secrets here.
