# App
VITE_APP_URL=http://localhost:5182

# Supabase — find these in your project's API settings
# https://supabase.com/dashboard/project/<project-ref>/settings/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Backend API — use a relative path in local development so Vite can proxy it
VITE_API_URL=/api/v1
