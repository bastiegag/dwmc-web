# Frontend origin used by Supabase Auth redirect URLs.
# Local: http://localhost:5182
# Set the Vercel Preview or Production origin for deployed environments.
VITE_APP_URL=http://localhost:5182

# Supabase browser client configuration. These values are public client values.
# https://supabase.com/dashboard/project/<project-ref>/settings/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Backend API origin. Use the local proxy path for local development.
# Staging and Production use the corresponding Render API origin.
VITE_API_URL=/api/v1

# Never add DATABASE_URL, PostgreSQL credentials, SUPABASE_SERVICE_ROLE_KEY,
# VERCEL_TOKEN, Render credentials, or other backend secrets to this file.
