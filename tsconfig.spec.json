{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.spec.tsbuildinfo",
        "types": ["vitest/globals", "vite/client"]
    },
    "include": [
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/test/**/*.ts",
        "src/test/**/*.tsx"
    ],
    "exclude": ["e2e/**"]
}
